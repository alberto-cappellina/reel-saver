# Deploy configuration — copy this file to ".deploy.env" and fill it in.
# ".deploy.env" is gitignored: it does NOT end up in the repository.

# URL of the auto-update version.json you publish on your hosting.
# Leave empty to build an APK WITHOUT auto-update.
UPDATE_URL="https://your-host.example/app/version.json"

# Public direct URL to the APK (written inside version.json).
APK_URL="https://your-host.example/app/reel-saver.apk"

# FTP of your static hosting (any provider works).
ARUBA_FTP_HOST="ftp.your-host.example"
ARUBA_FTP_DIR="/public_html/app"
ARUBA_FTP_USER="ftp-user"

# The PASSWORD does NOT go here: pass it at runtime, e.g.
#   ARUBA_FTP_PASS="..." ./scripts/release.sh --upload
