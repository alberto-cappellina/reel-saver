# Configurazione di deploy — copia questo file in ".deploy.env" e compila.
# ".deploy.env" è gitignorato: NON finisce nel repository.

# URL del JSON di auto-update che pubblichi sul tuo hosting.
# Lascialo vuoto per compilare un APK SENZA auto-update.
UPDATE_URL="https://tuo-host.example/app/version.json"

# URL pubblico diretto all'APK (viene scritto dentro version.json).
APK_URL="https://tuo-host.example/app/reel-saver.apk"

# FTP del tuo hosting statico (qualsiasi provider va bene).
ARUBA_FTP_HOST="ftp.tuo-host.example"
ARUBA_FTP_DIR="/public_html/app"
ARUBA_FTP_USER="utente-ftp"

# La PASSWORD non si mette qui: passala a runtime, es.
#   ARUBA_FTP_PASS="..." ./scripts/release.sh --upload
